# What an incident from this route looks like. Severity comes from the
# Service's Tier: tier-0 Critical, tier-1 Major, anything else Minor.

locals {
  service_tier = "alert.attributes.${incident_alert_attribute.service.id}.catalog_attribute[\"${incident_catalog_type_attribute.service_tier.id}\"]"
  tier_severity = [
    { tier = "tier-0", severity = data.incident_severity.critical.id },
    { tier = "tier-1", severity = data.incident_severity.major.id },
  ]
}

resource "incident_incident_template" "netflix_alert_incident" {
  name = "Netflix alert incident"

  expressions = [{
    label          = "Severity from Service tier"
    reference      = "sevtier1"
    root_reference = "alert"
    operations = [{
      operation_type = "branches"
      branches = {
        returns = { type = "IncidentSeverity", array = false }
        branches = [for b in local.tier_severity : {
          condition_groups = [{
            conditions = [{
              subject        = local.service_tier
              operation      = "equals"
              param_bindings = [{ value = { literal = b.tier } }]
            }]
          }]
          result = { value = { literal = b.severity } }
        }]
      }
    }]
    else_branch = {
      result = { value = { literal = data.incident_severity.minor.id } }
    }
  }]

  template = {
    # Written as raw JSON: jsonencode() would escape "->" and cause a diff.
    name = {
      autogenerated = false
      value         = { literal = file("${path.module}/templates/incident_name.json") }
    }
    summary = {
      autogenerated = false
      value         = { literal = file("${path.module}/templates/incident_summary.json") }
    }

    severity = {
      binding        = { value = { reference = "expressions[\"sevtier1\"]" } }
      merge_strategy = "max"
    }

    start_in_triage = { value = { literal = "true" } }

    custom_fields = [{
      custom_field_id = data.incident_custom_field.affected_teams.id
      merge_strategy  = "append"
      binding = {
        array_value = [{ reference = "alert.attributes.${local.team_attribute_id}" }]
      }
    }]
  }
}
